# No credentials are required for the first sales-only release.
# All client-side checkouts are hosted and fulfilled by Hotmart.
# Do NOT enable ARO, protected PDFs or Supabase auth for this launch.
# Future lead capture MUST be gated until a consent-aware backend is connected.

# Immersive preview. Defaults keep 3D and unverified voice off; HTML remains complete.
NEXT_PUBLIC_LIA_IMMERSIVE_ENABLED=false
NEXT_PUBLIC_LIA_VOICE_ENABLED=false
# Chat. While not "true" every chat entry point shows "muito em breve" and links to WhatsApp. Set it to true
# (with LIA_API_URL, LIA_SERVICE_TOKEN and Redis configured) and redeploy to open the live chat.
NEXT_PUBLIC_LIA_CHAT_ENABLED=false
# Server-only. Never copy these into NEXT_PUBLIC variables or client components.
LIA_API_URL=
LIA_SERVICE_TOKEN=
# Upstash-compatible Redis REST endpoint for the durable public-chat budget.
# Missing configuration or limiter outage returns 503; no demo or fail-open mode.
LIA_RATE_LIMIT_REDIS_URL=
LIA_RATE_LIMIT_REDIS_TOKEN=
